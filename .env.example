BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
ADMIN_ID=YOUR_TELEGRAM_NUMERIC_ID
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

DB_HOST=localhost
DB_PORT=3306
DB_USER=farnoud
DB_PASSWORD=CHANGE_ME
DB_NAME=farnoudbot

# Telegram Mini App
BOT_USERNAME=YourBotUsername
TELEGRAM_INIT_DATA_MAX_AGE=86400
MIN_CHARGE=10000
MAX_CHARGE=50000000
MINIAPP_URL=https://your-domain.example/miniapp/

# Public HTTPS base URL (ضروری برای webhook و واریزا)
PUBLIC_BASE_URL=https://your-domain.example

# --- حالت Webhook (برای cPanel / aaPanel / هاست اشتراکی) ---
# روی VPS با systemd معمولاً 0 بگذارید (polling)
USE_WEBHOOK=0
WEBHOOK_PATH=/telegram/webhook
# توکن اختیاری برای امنیت بیشتر وب‌هوک (رشته تصادفی)
WEBHOOK_SECRET=
# فقط وقتی main.py را با webhook standalone اجرا می‌کنید:
# WEBHOOK_LISTEN=0.0.0.0
# WEBHOOK_PORT=8443
